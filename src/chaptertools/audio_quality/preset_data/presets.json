{
  "Gentle cleanup": {
    "stages": {
      "highpass": {"bypass": false, "params": {"cutoff_hz": 60}},
      "denoise": {"bypass": false, "params": {"mode": "spectral", "strength": 0.25, "per_segment": false}},
      "enhance": {"bypass": true},
      "declick": {"bypass": true},
      "eq": {"bypass": true},
      "deesser": {"bypass": true},
      "compressor": {"bypass": false, "params": {"threshold_db": -22, "ratio": 1.5, "attack_ms": 25, "release_ms": 180, "makeup_db": 0}},
      "gate": {"bypass": true}
    }
  },
  "Noisy room": {
    "stages": {
      "highpass": {"bypass": false, "params": {"cutoff_hz": 90}},
      "denoise": {"bypass": false, "params": {"mode": "spectral", "strength": 0.45, "per_segment": false}},
      "gate": {"bypass": true}
    }
  },
  "Muffled / dull": {
    "stages": {
      "eq": {
        "bypass": false,
        "params": {
          "box_freq": 350,
          "box_gain": -2,
          "box_q": 0.8,
          "presence_freq": 3000,
          "presence_gain": 2.5,
          "presence_q": 0.8,
          "trim_db": -3
        }
      }
    }
  },
  "Boomy / proximity": {
    "stages": {
      "highpass": {"bypass": false, "params": {"cutoff_hz": 100}},
      "eq": {"bypass": false, "params": {"box_freq": 250, "box_gain": -3, "box_q": 1.0}},
      "deesser": {"bypass": true}
    }
  },
  "Harsh / sibilant": {
    "stages": {
      "denoise": {"bypass": true},
      "declick": {"bypass": true},
      "eq": {
        "bypass": false,
        "params": {"air_freq": 7500, "air_gain": -1.5, "air_q": 0.7, "air_shape": "shelf"}
      },
      "deesser": {"bypass": false, "params": {"frequency_hz": 7000, "threshold_db": -9}}
    }
  },
  "Old / archival": {
    "stages": {
      "denoise": {"bypass": false, "params": {"mode": "deepfilter", "strength": 0.6}},
      "declick": {"bypass": false, "params": {"threshold": 0.5, "sensitivity": 0.4}},
      "eq": {
        "bypass": false,
        "params": {
          "presence_freq": 3000,
          "presence_gain": 2,
          "air_freq": 8000,
          "air_gain": 1,
          "air_shape": "shelf"
        }
      },
      "gate": {"bypass": true},
      "limiter": {"bypass": false, "params": {"ceiling_db": -3}}
    }
  },
  "Audiobook master": {
    "stages": {
      "compressor": {
        "bypass": false,
        "params": {"threshold_db": -20, "ratio": 2, "attack_ms": 25, "release_ms": 150, "makeup_db": 0}
      },
      "loudness": {"bypass": false, "params": {"target_lufs": -18, "true_peak_db": -3}},
      "limiter": {"bypass": false, "params": {"ceiling_db": -3}}
    }
  }
}
